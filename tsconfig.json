{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "composite": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "pretty": true,
    "sourceMap": false,
    "stripInternal": true,
    "strict": true,
    "target": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "node",
    "isolatedModules": true,
    "esModuleInterop": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"]
  //"exclude": ["node_modules"]
  //"include": ["src/**/*.ts", "test/**/*.ts", "generate-tests.ts"],
  //"exclude": ["node_modules"]
}
